generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  ka
  en
  ru
  zh
}

enum TourDestination {
  batumi
  tbilisi
  kutaisi
}

/// Admin-created and future DB-backed tours (slug id, e.g. wine-tour-kakheti)
model Tour {
  id           String             @id
  destinations TourDestination[]  @default([])
  durationKey  String
  priceFrom   Int              @default(0)
  minPeople   Int              @default(0)
  startTime   String?
  popular     Boolean          @default(false)
  exclusive   Boolean          @default(false)
  /// string[] — image URLs
  images      String[]         @default([])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  translations TourTranslation[]

  @@map("tours")
}

/// Localized tour content (ka, en, ru, zh)
model TourTranslation {
  id           String @id @default(cuid())
  tourId       String
  locale       Locale
  title        String
  routeLabel   String
  subtitle     String?
  /// string[] — outline bullet points
  outline      Json
  /// TourSection[] — { title, days: { label, description }[] }
  sections     Json
  /// string[]
  includes     Json
  /// string[] | null
  highlights   Json?
  clothingNote String?

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([tourId, locale])
  @@map("tour_translations")
}

/// Admin-created and future DB-backed excursions (slug id)
model Excursion {
  id           String             @id
  destinations TourDestination[]  @default([])
  durationKey  String
  priceFrom   Int      @default(0)
  grades      String
  popular     Boolean  @default(false)
  /// string[] — image URLs
  images      Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  translations ExcursionTranslation[]

  @@map("excursions")
}

/// Localized excursion content (ka, en, ru, zh)
model ExcursionTranslation {
  id           String  @id @default(cuid())
  excursionId  String
  locale       Locale
  title        String
  /// string[]
  highlights   Json
  /// string[]
  includes     Json
  optionalNote String?

  excursion Excursion @relation(fields: [excursionId], references: [id], onDelete: Cascade)

  @@unique([excursionId, locale])
  @@map("excursion_translations")
}

enum BookingType {
  tour
  excursion
}

enum BookingStatus {
  pending
  confirmed
  cancelled
}

/// Client booking requests from the public site
model Booking {
  id            String        @id
  bookingType   BookingType
  itemId        String
  itemTitle     String
  name          String
  email         String
  phone         String
  preferredDate String?
  endDate       String?
  endTime       String?
  peopleCount   Int?
  message       String
  locale        Locale?
  status        BookingStatus @default(pending)
  reviewRequestedAt DateTime?
  reminderSentAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  review Review?

  @@index([createdAt(sort: Desc)])
  @@index([status])
  @@map("bookings")
}

/// Customer reviews submitted after tours/excursions
model Review {
  id         String      @id @default(cuid())
  bookingId  String      @unique
  itemType   BookingType
  itemId     String
  itemTitle  String
  authorName String
  text       String
  rating     Int         @default(5)
  locale     Locale?
  published  Boolean     @default(true)
  createdAt  DateTime    @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([itemType, itemId])
  @@index([createdAt(sort: Desc)])
  @@map("reviews")
}

/// Admin-managed blog posts (slug id)
model BlogPost {
  id         String   @id
  coverImage String?
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  translations BlogPostTranslation[]

  @@index([createdAt(sort: Desc)])
  @@map("blog_posts")
}

/// Localized blog content (ka, en, ru)
model BlogPostTranslation {
  id         String @id @default(cuid())
  blogPostId String
  locale     Locale
  title      String
  excerpt    String @default("")
  body       String @default("")

  blogPost BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@unique([blogPostId, locale])
  @@map("blog_post_translations")
}
